MARIADB_HOST=127.0.0.1
MARIADB_PORT=3306
MARIADB_DATABASE=lane_demo
MARIADB_USER=vehicle_ai
MARIADB_PASSWORD="change-me"
# URL stream camera IP mặc định. Phải là luồng RTSP/HTTP video, không phải trang quản trị.
# Hikvision main: rtsp://USER:PASSWORD@192.168.1.64:554/Streaming/Channels/101
# Hikvision sub:  rtsp://USER:PASSWORD@192.168.1.64:554/Streaming/Channels/102
# Dahua main:     rtsp://USER:PASSWORD@192.168.1.108:554/cam/realmonitor?channel=1&subtype=0
IP_CAM_URL=
# Hoặc để trống IP_CAM_URL và điền các trường rời; UI tự tạo URL RTSP.
IP_CAM_HOST=
IP_CAM_PORT=554
IP_CAM_USER=
IP_CAM_CHANNEL=1
IP_CAM_STREAM=main
IP_CAM_BRAND=hikvision
IP_CAM_PATH=
# Mật khẩu camera không đưa vào API cấu hình; nhập trực tiếp trên UI mỗi phiên.
# In Docker, a database on the Windows host uses host.docker.internal.
# VDTC_IMAGE_ROOT=D:/VDTC11
